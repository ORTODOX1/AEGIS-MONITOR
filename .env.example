# Copy to .env and adjust. .env itself is git-ignored.

# --- Mock data server ---
PORT=3001

# --- Frontend (Vite; VITE_* variables are inlined into the browser bundle) ---
VITE_WS_URL=ws://localhost:3001/ws
VITE_VESSEL_NAME=M/V AEGIS PIONEER

# --- TimescaleDB container (docker compose) ---
# Provisioned for the planned persistence layer; nothing connects to it yet.
# docker compose refuses to start unless POSTGRES_PASSWORD is set.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aegis_monitor
